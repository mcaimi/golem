# Golem — environment variables
#
# Copy to .env and edit:   cp .env.example .env
#
# Every variable uses the ARPOISON_ prefix (see api/config.py).
# Values set inline in podman-compose.yml `environment:` win over .env.
#
# ============================================================================
# Server
# ============================================================================
# Host bind address (0.0.0.0 = all interfaces).
ARPOISON_HOST=0.0.0.0
# Server port. With network_mode: host this binds directly on the host.
ARPOISON_PORT=8080

# ============================================================================
# Backend binary
# ============================================================================
# Path to the compiled C binary. In the image this is baked in at
# /app/backend/bin/arpoison.bin. Override only if you mount a different
# binary into the container.
ARPOISON_BINARY_PATH=/app/backend/bin/arpoison.bin

# ============================================================================
# Timing / lifecycle
# ============================================================================
# Default flood timing in milliseconds (used when a request omits timing_ms).
ARPOISON_DEFAULT_TIMING_MS=2000
# Seconds to wait for a clean SIGTERM before escalating to SIGKILL.
ARPOISON_PROCESS_STOP_TIMEOUT=5.0
# Seconds to wait for the binary's init output before giving up.
ARPOISON_STARTUP_PARSE_TIMEOUT=15.0
